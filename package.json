{
  "name": "kintime-security-tests",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-kintime 'node --test tests/firestore.test.mjs'",
    "test:sync": "firebase emulators:exec --only auth,firestore --project demo-kintime './gradlew :app:connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=app.kintime.family.FamilySyncTest -Pandroid.testInstrumentationRunnerArguments.firebaseEmulators=true --console=plain'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1"
  }
}
